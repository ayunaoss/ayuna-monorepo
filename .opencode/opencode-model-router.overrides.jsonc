{
  // 1. Default Preset & Budget Routing Mode
  // Note: Runtime slash commands (/preset, /budget) write to opencode-model-router.state.json,
  // which takes precedence over these defaults once toggled in a session.
  "activePreset": "ayuna-hybrid",
  "activeMode": "quality", // Options: "budget" | "normal" | "quality" | "deep"

  // 2. Host Enforcement & Budget Controls
  "enforcement": {
    "mode": "enforced", // Enforces read-only boundaries and step/dispatch caps
  },

  // 3. Custom or Overridden Provider Presets
  // Built-in presets you can also override: "anthropic", "openai", "copilot", "google", "hybrid", "zai"
  "presets": {
    "ayuna-hybrid": {
      "fast": {
        // Optional $0 alternative (200K context cap, zero-retention): "opencode/deepseek-v4.1-flash-free"
        "model": "opencode/deepseek-v4.1-flash",
        "variant": "low",
        "costRatio": 1, // 1x baseline ($0.30/$1.20, $0.006 cache read)
        "steps": 30, // Max tool steps per subagent dispatch
        "readOnly": true, // Host-enforced read-only (grep, read, glob, git inspection)
      },
      "medium": {
        "model": "opencode/gpt-6.2-sol",
        "variant": "medium",
        "costRatio": 8, // ~8x baseline ($2/$10, $0.10 cache read, concise medium reasoning)
        "steps": 50,
        "readOnly": false, // Allows file edits, rename, shell, and test execution
      },
      "heavy": {
        "model": "opencode/claude-sonnet-5-5",
        "variant": "high",
        "costRatio": 12, // ~12x baseline ($2/$10, $0.20 cache read + deeper high reasoning)
        "steps": 120,
        "readOnly": false,
      },
    },
  },

  // 4. Task-Based Selection Taxonomy (Shared across all presets)
  // The orchestrator matches user intent against these patterns to delegate or split composite tasks
  "taskPatterns": {
    "fast": [
      "search/grep/read",
      "git-info/ls",
      "lookup-docs",
      "summarize-file",
      "find-usages",
    ],
    "medium": [
      "impl/feature",
      "refactor/rename",
      "write-tests",
      "fix-lint/typecheck",
      "api-endpoint",
    ],
    "heavy": [
      "arch/system-design",
      "debug-complex/race-condition",
      "security-audit",
      "multi-module-migration",
      "performance-optimization",
    ],
  },

  // 5. Custom Orchestrator Routing Rules
  "rules": [
    "self∈{sonnet,opus,fable}→never→@heavy", // Avoid double-paying or downgrading if orchestrator is already Sonnet 5.5+
    "composite-task→split(@fast:explore,@medium:implement)", // Explore cheap (1x), execute smart (8x)
  ],
}
